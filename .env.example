# Copy to .env and fill in the values. The app NEVER writes .env: every line is added by hand.
# Names only here, never real values.

# Required in Docker (0.10.2). Which Everstats this is: production (everstats.app, this file) or dev
# (dev.everstats.app, its own folder and .env: .env.dev.example). The app refuses to start unless its address and
# database match it. Leave it out for `npm run dev`.
ENVIRONMENT=production

# Required. Encrypts every API key stored from the admin page and every 2FA secret. `npm run gen-key root` prints one.
# Keep a copy somewhere safe: losing or changing it makes those unreadable (keys re-entered, 2FA re-enrolled).
# Both processes refuse to start without it.
EVERSTATS_ROOT_KEY=

# Required in Docker. The database password; docker-compose.yml builds DATABASE_URL from it.
# `npm run gen-key postgres` prints a URL-safe one.
POSTGRES_PASSWORD=

# Docker only. The host address both app ports are published on (docker-compose.yml): the address the tunnel
# reaches the app at, or 127.0.0.1 for this machine only. Required; never falls back to 0.0.0.0. The deploy passes
# its own BIND_IP (a Gitea variable), which overrides this line.
BIND_IP=

# Docker only. Host folders for the database (see docker-compose.yml): direct disk/pool paths, never /mnt/user.
# Both must exist, owned by 999:999. The deploy passes its own (Gitea variables), which override these lines.
PG_DATA_DIR=
PG_SNAPSHOT_DIR=

# Docker only. Host folder for the worker's nightly database backups (RESTORE.md). A flat file write, so a /mnt/user
# share is fine. Must exist, writable by uid 1000. The deploy passes its own (a Gitea variable).
BACKUP_DIR=

# Optional. Host ports (defaults 3260 web, 3261 worker). If you change them, set the same WEB_PORT / WORKER_PORT
# Gitea variables so the deploy probes the right ones.
# WEB_PORT=3260
# WORKER_PORT=3261

# Optional. The address visitors use; OAuth redirects, passkeys and the CSRF check derive from it.
# Docker defaults to https://everstats.app; `npm run dev` to http://localhost:3000.
# PUBLIC_ORIGIN=https://everstats.app

# Optional fallbacks for the admin key manager (keys entered there win). Normally leave these empty and use the
# admin page.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Optional. Where the tunnel's connections come from as the web container sees them (IPs or CIDRs, comma-separated).
# When set, CF-Connecting-IP is honoured only from there, so a LAN device can't fake one to dodge the rate limits.
# The app logs each address the header arrives from, once, on ANY request (open the site through the tunnel, then
# docker logs everstats 2>&1 | grep CF-Connecting-IP); the admin page lists them too. Use the address shown there.
TRUSTED_PROXIES=

# Local runs outside Docker only. Defaults shown. Unset DATABASE_URL: `npm run dev` starts an embedded dev database.
# DATABASE_URL=postgres://postgres@127.0.0.1:5439/postgres
# PORT=3260
# WORKER_PORT=3261
