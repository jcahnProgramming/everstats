# DEV's .env: the private test site at dev.everstats.app (RELEASING.md, docker-compose.dev.yml).
# Copy to .env in DEV's own deploy folder (never production's) and fill in the values by hand. The app never writes it.
# Names only here, never real values. NOTHING here may be copied from production's .env: the dev deploy refuses a
# dev .env that reuses production's root key, database password, or Blizzard / Discord client id.

# Required, exactly this. The app refuses to start as dev unless its address is https://dev.everstats.app and its
# database is everstats-dev-db / everstats_dev (server/core/environment.js).
ENVIRONMENT=dev

# Makes a plain `docker compose …` in this folder use dev's file and project, never production's.
COMPOSE_FILE=docker-compose.dev.yml
COMPOSE_PROJECT_NAME=everstats-dev

# Required. Dev's OWN root key (`npm run gen-key root`). Encrypts the keys entered on dev's admin page and dev's 2FA
# secrets. Keep a copy outside the server.
EVERSTATS_ROOT_KEY=

# Required. Dev's OWN database password (`npm run gen-key postgres`).
POSTGRES_PASSWORD=

# Required. Three octets of a /24 for dev's compose network that is NOT production's (production's is in production's
# .env or docker-compose.yml's default). Docker refuses one that overlaps any other network.
EVERSTATS_DEV_SUBNET_PREFIX=

# Required for real rate limits: dev's network gateway, <EVERSTATS_DEV_SUBNET_PREFIX>.1 (the address cloudflared's
# connections arrive from, as for production). Check it on dev's admin page (Proxy addresses) after the first visit.
TRUSTED_PROXIES=

# The deploy passes these from Gitea variables (BIND_IP, DEV_PG_DATA_DIR, DEV_PG_SNAPSHOT_DIR, DEV_BACKUP_DIR,
# DEV_WEB_PORT, DEV_WORKER_PORT). Set them here too only if you run `docker compose` in this folder by hand.
# BIND_IP=
# DEV_PG_DATA_DIR=
# DEV_PG_SNAPSHOT_DIR=
# DEV_BACKUP_DIR=
# DEV_WEB_PORT=3270
# DEV_WORKER_PORT=3271

# Optional fallbacks for dev's admin key manager (keys entered on dev's admin page win). Dev's OWN clients only:
# the "Everstats Dev" Blizzard client and the "Everstats Dev" Discord application.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
